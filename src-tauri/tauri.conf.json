{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "SimpleBar",
  "version": "0.1.0",
  "identifier": "com.danielallen.simplebar",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "macOSPrivateApi": true,
    "windows": [
      {
        "title": "SimpleBar",
        "width": 800,
        "height": 800,
        "resizable": true,
        "minWidth": 300,
        "minHeight": 300,
        "alwaysOnTop": false,
        "transparent": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": {
      "../statusline/target/release/simplebar-statusline": "simplebar-statusline"
    }
  }
}
